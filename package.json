{
  "name": "streamdeck-plugin-au-uv",
  "version": "0.1.0",
  "description": "Stream Deck plugin showing AU UV index values from ARPANSA",
  "type": "module",
  "main": "com.peterneave.streamdeck-plugin-au-uv.sdPlugin/plugin.js",
  "scripts": {
    "test": "node --test",
    "bundle": "node scripts/bundle-plugin.mjs",
    "build": "npm test && npm run bundle",
    "pack": "npm run build && streamdeck pack --force --output dist com.peterneave.streamdeck-plugin-au-uv.sdPlugin && node scripts/rename-packed-plugin.mjs",
    "link": "npm run bundle && streamdeck link com.peterneave.streamdeck-plugin-au-uv.sdPlugin",
    "unlink": "streamdeck unlink com.peterneave.streamdeck-plugin-au-uv"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.1",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20.5.0 <21"
  }
}
